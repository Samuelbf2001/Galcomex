generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Autenticación (Better Auth) ─────────────────────────────────────────────
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rol           Rol      @default(OPERATIVO)

  sessions                 Session[]
  accounts                 Account[]
  auditLogs                AuditLog[]
  doCreados                TramiteDO[]        @relation("CreadoPor")
  checklistChecks          ChecklistItem[]    @relation("ValidadoPor")
  documentos               Documento[]        @relation("SubidoPor")
  borradoresAprobados      BorradorFactura[]  @relation("AprobadoPor")
  borradoresFact           BorradorFactura[]  @relation("FacturadoPor")
  facturasProveedorSubidas FacturaProveedor[] @relation("FacturasProveedorSubidas")
  pagosFactura             PagoFactura[]      @relation("PagosFacturaRegistrados")
  enlacesDocumento         DocumentoEnlace[]  @relation("EnlaceCreadoPor")
  movimientosCuenta        MovimientoCuenta[] @relation("MovimientosCuentaRegistrados")
  tarifariosCreados        Tarifario[]        @relation("TarifarioCreadoPor")
  eventosMarcados          TramiteEvento[]    @relation("EventoMarcadoPor")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

enum Rol {
  ADMIN // Camila — acceso total
  REVISOR // Papá — aprueba facturas
  OPERATIVO // Karina, Sr. Lucho — operación diaria
  SOCIO // Luis Martínez — solo sus trámites
}

// ─── Clientes ─────────────────────────────────────────────────────────────────
enum TipoCliente {
  PROPIO
  SOCIO_LM
}

/// Ficha de empresa (contraparte). Se llama `Cliente` por historia; una misma
/// empresa puede ser cliente y proveedor a la vez (Ascinter, Coldex, Eltrans),
/// por eso los roles son flags y no un enum. `tipo` queda como dato
/// descriptivo/legacy: el comportamiento se decide por capacidades
/// (ver `EmpresaCapacidad` y `src/lib/capacidades/`).
model Cliente {
  id             String      @id @default(cuid())
  nombre         String
  nit            String      @unique
  tipo           TipoCliente @default(PROPIO)
  contactoNombre String?
  contactoEmail  String?
  contactoTel    String?
  /// @deprecated Migrado a la capacidad `anticipos_cliente`. Se mantiene
  /// sincronizado durante la transición; leer vía `capacidadesDe()`.
  manejaAnticipo Boolean     @default(true)
  activo         Boolean     @default(true)

  // Roles simultáneos de la contraparte
  esCliente   Boolean @default(true)
  esProveedor Boolean @default(false)

  // Grupo económico (Polired / Polired Zona Franca / Sesderma bajo una casa)
  grupoEmpresaId String?
  grupoEmpresa   GrupoEmpresa? @relation(fields: [grupoEmpresaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tarifas       TarifaCliente[]
  tarifarios    Tarifario[]
  tramites      TramiteDO[]
  anticipos     Anticipo[]
  facturas      Factura[]
  capacidades   EmpresaCapacidad[]
  /// Fichas de pago vinculadas a esta empresa (puente hacia el rol proveedor
  /// mientras `Beneficiario` y `Cliente` siguen siendo tablas separadas).
  beneficiarios Beneficiario[]     @relation("BeneficiarioEmpresa")
  movimientos   MovimientoCuenta[]

  @@index([grupoEmpresaId])
  @@map("cliente")
}

// ─── Cuenta corriente por contraparte (M5) ────────────────────────────────────
//
// Una misma empresa puede debernos como cliente y que le debamos como
// proveedor. El saldo de las dos puntas se calcula en
// `src/lib/cuenta-corriente/calculo.ts` (función pura) cruzando lo DERIVADO
// (facturas de venta, abonos, facturas de proveedor, pagos) con lo que se
// registra a mano aquí: los importes que no nacen de un trámite.
//
//   · Cargos manuales   — la mensualidad variable de Coldex, quincenas, primas.
//   · Comisiones        — lo que Eltrans le paga a Galcomex por contenedor.
//   · Ajustes           — correcciones puntuales, siempre auditadas.

enum RolCuenta {
  CLIENTE // la empresa nos debe
  PROVEEDOR // le debemos a la empresa
}

enum TipoMovimientoCuenta {
  CARGO // aumenta lo que la empresa nos debe
  ABONO // aumenta lo que nosotros le debemos
}

enum OrigenMovimientoCuenta {
  CARGO_MANUAL
  COMISION
  AJUSTE
}

model MovimientoCuenta {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Cliente @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  rol    RolCuenta
  tipo   TipoMovimientoCuenta
  origen OrigenMovimientoCuenta

  /// Dimensión de cartera, espejo de `TipoTramite.lineaServicio`:
  /// "TRAMITE" | "CLASIFICACION" | "PLAN_VALLEJO" | "COMISION" | "ASESORIA".
  lineaServicio String @default("TRAMITE")

  concepto String
  valor    BigInt // COP enteros, SIEMPRE positivo: el signo lo da `tipo`
  fecha    DateTime

  /// Trámite que originó el movimiento (una comisión por contenedor, p. ej.).
  tramiteId String?
  tramite   TramiteDO? @relation(fields: [tramiteId], references: [id], onDelete: SetNull)

  registradoPorId String
  registradoPor   User   @relation("MovimientosCuentaRegistrados", fields: [registradoPorId], references: [id])

  createdAt DateTime @default(now())

  @@index([empresaId, rol])
  @@index([tramiteId])
  @@map("movimiento_cuenta")
}

// ─── Grupo económico ──────────────────────────────────────────────────────────
model GrupoEmpresa {
  id        String   @id @default(cuid())
  nombre    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresas    Cliente[]
  capacidades GrupoEmpresaCapacidad[]

  @@map("grupo_empresa")
}

// ─── Capacidades (interruptores de función por empresa) ───────────────────────
//
// Toda diferencia de comportamiento entre empresas se declara aquí como dato,
// nunca como rama en el código. Resolución en cascada (ver
// `src/lib/capacidades/resolver.ts`):
//
//     Capacidad.porDefecto  →  GrupoEmpresaCapacidad  →  EmpresaCapacidad
//
// `habilitado` y `config` se resuelven de forma INDEPENDIENTE: cada uno toma el
// nivel más específico que lo define. Así un grupo puede fijar la config y una
// empresa limitarse a encender o apagar la función.

enum AmbitoCapacidad {
  EMPRESA // se resuelve por empresa (con override de grupo)
  GLOBAL // interruptor del sistema, sin override por empresa
}

model Capacidad {
  codigo           String          @id // "tarifario_propio", "base_cif", ...
  nombre           String
  descripcion      String?
  grupo            String // agrupador visual en la UI: "Comercial" | "Operacion" | "Cartera" | "Documentos"
  ambito           AmbitoCapacidad @default(EMPRESA)
  porDefecto       Boolean         @default(false)
  /// Config por defecto de la capacidad (forma libre por capacidad; los
  /// consumidores la validan con Zod al leerla).
  configPorDefecto Json?
  orden            Int             @default(0)
  activa           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  empresas EmpresaCapacidad[]
  grupos   GrupoEmpresaCapacidad[]

  @@map("capacidad")
}

model EmpresaCapacidad {
  empresaId  String
  empresa    Cliente   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo     String
  capacidad  Capacidad @relation(fields: [codigo], references: [codigo], onDelete: Cascade)
  habilitado Boolean
  config     Json?
  updatedAt  DateTime  @updatedAt

  @@id([empresaId, codigo])
  @@index([codigo])
  @@map("empresa_capacidad")
}

model GrupoEmpresaCapacidad {
  grupoId    String
  grupo      GrupoEmpresa @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  codigo     String
  capacidad  Capacidad    @relation(fields: [codigo], references: [codigo], onDelete: Cascade)
  habilitado Boolean
  config     Json?
  updatedAt  DateTime     @updatedAt

  @@id([grupoId, codigo])
  @@index([codigo])
  @@map("grupo_empresa_capacidad")
}

model TarifaCliente {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  anio      Int
  tipo      String // "por_contenedor" | "fijo" | "porcentaje_cif"
  valor     BigInt // COP sin decimales

  @@unique([clienteId, anio, tipo])
  @@map("tarifa_cliente")
}

// ─── Trámites (DO) ────────────────────────────────────────────────────────────
enum Ciudad {
  BAQ
  CTG
  BUN
  SMR
}

enum AgenciaAduanas {
  MOVIADUANAS
  COLDEX
  AR_LOGISTY
}

// ─── Tipos de trámite (M4) ────────────────────────────────────────────────────
//
// La clasificación arancelaria NO es un caso especial de Litoplas: es una fila
// de esta tabla. Un tipo nuevo (Plan Vallejo, por ejemplo) es configuración,
// no un módulo nuevo.

enum SecuenciaTramite {
  CIUDAD_ANIO // DO.BAQ26-0001 — un contador por ciudad y año (importaciones)
  ANIO // CLAS26-0001  — un contador por año, sin ciudad
  GLOBAL // un único contador para todo el histórico
}

model TipoTramite {
  codigo      String  @id // "IMPORTACION" | "CLASIFICACION"
  nombre      String
  descripcion String?

  // Consecutivo
  prefijoConsecutivo         String // "DO" | "CLAS"
  secuenciaPor               SecuenciaTramite @default(CIUDAD_ANIO)
  incluyeCiudadEnConsecutivo Boolean          @default(true)

  /// Dimensión de cartera: "TRAMITE" | "CLASIFICACION" | "PLAN_VALLEJO".
  /// Separa las carteras sin duplicar módulos (M5).
  lineaServicio       String  @default("TRAMITE")
  /// La factura de venta de este tipo no se mezcla con la de los trámites.
  facturacionSeparada Boolean @default(false)

  /// Capacidad que la empresa debe tener encendida para poder abrir trámites
  /// de este tipo (p. ej. "clasificacion_arancelaria"). Null = disponible para
  /// todas las empresas.
  capacidadRequerida String?

  // Campos del formulario que este tipo sí necesita
  requiereAgenciaAduanas    Boolean         @default(true)
  agenciaAduanasPorDefecto  AgenciaAduanas?
  requiereEta               Boolean         @default(true)
  usaChecklist              Boolean         @default(true)
  /// Etiqueta del número externo de referencia (el consecutivo que asigna la
  /// clasificadora: 2110, 2117, 2140). Null = el tipo no lleva referencia externa.
  etiquetaReferenciaExterna String?

  orden     Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tramites TramiteDO[]

  @@map("tipo_tramite")
}

enum EstadoTramite {
  SOLICITUD
  APERTURA
  EN_TRAMITE
  EN_PUERTO
  DESPACHADO
  ENVIADO_A_FACTURAR
  FACTURADO
  PAGADO
  CERRADO
}

model TramiteDO {
  id                String          @id @default(cuid())
  consecutivo       String          @unique // DO.CTG26-0124 · CLAS26-0001
  tipoTramiteCodigo String          @default("IMPORTACION")
  tipoTramite       TipoTramite     @relation(fields: [tipoTramiteCodigo], references: [codigo], onDelete: Restrict)
  /// Número que asigna un tercero al servicio (p. ej. el informe de la
  /// clasificadora: 2110, 2117, 2140). No es un consecutivo de Galcomex.
  referenciaExterna String?
  ciudad            Ciudad
  anio              Int
  numero            Int
  clienteId         String
  cliente           Cliente         @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  proveedorCliente  String?
  agenciaAduanas    AgenciaAduanas?
  doAgencia         String?
  doCliente         String?
  eta               DateTime?
  estado            EstadoTramite   @default(SOLICITUD)
  comentarios       String?

  fechaAceptacionDeclaracion DateTime?
  fechaLevante               DateTime?
  fechaEnviadoAFacturar      DateTime?
  fechaDocumentosOk          DateTime?
  fechaSalidaCarga           DateTime?

  // Base de cálculo del tarifario (M3). Todos opcionales: el motor reporta
  // qué falta en vez de inventar un cero.
  valorCif         BigInt? // valor en aduana, COP sin decimales
  tipoCarga        TipoCarga?
  numContenedores  Int?
  numDeclaraciones Int?
  numDocumentos    Int?
  numItems         Int? // ítems clasificados

  creadoPorId String
  creadoPor   User     @relation("CreadoPor", fields: [creadoPorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  eventos              TramiteEvento[]
  checklistItems       ChecklistItem[]
  documentos           Documento[]
  aplicacionesAnticipo AplicacionAnticipo[]
  pagos                PagoTramite[]
  borradores           BorradorFactura[]
  estadoLogs           EstadoLog[]
  auditLogs            AuditLog[]
  facturasProveedor    FacturaProveedor[]
  pseSolicitudes       PseSolicitud[]
  movimientosCuenta    MovimientoCuenta[]

  // Un número es único por tipo de trámite, ciudad y año. El tipo entra en la
  // clave porque cada uno lleva su propio contador (M4): la clasificación
  // arancelaria no consume consecutivos de importación.
  @@unique([tipoTramiteCodigo, ciudad, anio, numero])
  @@index([tipoTramiteCodigo])
  @@index([clienteId])
  @@index([estado])
  @@index([estado, fechaSalidaCarga])
  @@map("tramite_do")
}

model EstadoLog {
  id          String        @id @default(cuid())
  tramiteId   String
  tramite     TramiteDO     @relation(fields: [tramiteId], references: [id], onDelete: Cascade)
  estadoAntes EstadoTramite
  estadoDes   EstadoTramite
  usuarioId   String
  createdAt   DateTime      @default(now())

  @@index([tramiteId])
  @@map("estado_log")
}

// ─── Checklist de apertura ────────────────────────────────────────────────────
model PlantillaChecklist {
  id     String                   @id @default(cuid())
  nombre String
  items  PlantillaChecklistItem[]

  @@map("plantilla_checklist")
}

model PlantillaChecklistItem {
  id          String             @id @default(cuid())
  plantillaId String
  plantilla   PlantillaChecklist @relation(fields: [plantillaId], references: [id], onDelete: Cascade)
  descripcion String
  requerido   Boolean            @default(true)
  orden       Int                @default(0)

  @@map("plantilla_checklist_item")
}

model ChecklistItem {
  id              String    @id @default(cuid())
  tramiteId       String
  tramite         TramiteDO @relation(fields: [tramiteId], references: [id], onDelete: Cascade)
  descripcion     String
  requerido       Boolean   @default(true)
  recibido        Boolean   @default(false)
  validadoPorId   String?
  validadoPor     User?     @relation("ValidadoPor", fields: [validadoPorId], references: [id])
  fechaValidacion DateTime?

  @@index([tramiteId])
  @@map("checklist_item")
}

// ─── Documentos ───────────────────────────────────────────────────────────────
enum CategoriaDocumento {
  FACTURA_COMERCIAL
  BL
  PACKING_LIST
  DECLARACION_DIAN
  SOPORTE_FACTURACION
  FOTO_RECONOCIMIENTO
  COMPROBANTE_BANCARIO
  COMPROBANTE_COMERCIO
  FACTURA_PROVEEDOR
  OTRO
}

model Documento {
  id            String             @id @default(cuid())
  tramiteId     String
  tramite       TramiteDO          @relation(fields: [tramiteId], references: [id], onDelete: Cascade)
  categoria     CategoriaDocumento
  nombreArchivo String
  // Estructura en MinIO: tramites/{consecutivo}/{categoria}/{uuid}.ext
  storageKey    String
  mimeType      String
  tamanoBytes   Int
  eliminado     Boolean            @default(false)
  subidoPorId   String
  subidoPor     User               @relation("SubidoPor", fields: [subidoPorId], references: [id])
  createdAt     DateTime           @default(now())

  pagosTramite      PagoTramite[]      @relation("SoporteDocumento")
  pagosComercio     PagoTramite[]      @relation("ComprobanteComercio")
  facturasProveedor FacturaProveedor[] @relation("FacturaProveedorDoc")
  enlaces           DocumentoEnlace[]

  @@index([tramiteId, eliminado])
  @@map("documento")
}

// Enlace público para compartir un documento con terceros sin sesión.
// El token es la única credencial: URL /compartir/{token}.
model DocumentoEnlace {
  id          String    @id @default(cuid())
  token       String    @unique
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  expiraEn    DateTime
  revocado    Boolean   @default(false)
  creadoPorId String
  creadoPor   User      @relation("EnlaceCreadoPor", fields: [creadoPorId], references: [id])
  createdAt   DateTime  @default(now())

  @@map("documento_enlace")
}

// ─── Anticipos ────────────────────────────────────────────────────────────────
enum TipoRecaudo {
  BANCOLOMBIA // $1.950 (digital)
  OTROS_BANCOS // $2.200 (digital)
  SUCURSAL // $11.290 (físico)
  CORRESPONSAL // $6.190 (físico)
  CAJERO // $5.200 (físico)
}

enum EstadoMovimiento {
  BORRADOR // Registrado pero pendiente de confirmación
  REALIZADO // Ejecutado, pendiente de verificación contable
  VERIFICADO // Verificado por ADMIN (o por ADMIN/OPERATIVO en flujo propio)
}

enum CanalPago {
  TRANSF_BANCOLOMBIA // $3.900
  PSE // $0
  TRANSF_OTROS_BANCOS // $7.300
}

model MatrizRecaudo {
  id          String      @id @default(cuid())
  tipoRecaudo TipoRecaudo @unique
  grupo       String // "DIGITAL" | "FISICO"
  descripcion String
  costoFijo   BigInt

  @@map("matriz_recaudo")
}

model MatrizPago {
  id          String    @id @default(cuid())
  canalPago   CanalPago @unique
  descripcion String
  costoFijo   BigInt

  @@map("matriz_pago")
}

model Anticipo {
  id              String           @id @default(cuid())
  clienteId       String
  cliente         Cliente          @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  monto           BigInt // COP sin decimales
  fecha           DateTime
  tipoRecaudo     TipoRecaudo
  costoRecaudo    BigInt           @default(0) // Snapshot del costo al momento del registro
  soporteKey      String? // Comprobante bancario en MinIO
  verificadoBanco Boolean          @default(false)
  estado          EstadoMovimiento @default(REALIZADO)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  aplicaciones AplicacionAnticipo[]

  @@index([clienteId])
  @@index([fecha])
  @@map("anticipo")
}

model AplicacionAnticipo {
  id            String    @id @default(cuid())
  anticipoId    String
  anticipo      Anticipo  @relation(fields: [anticipoId], references: [id], onDelete: Restrict)
  tramiteId     String
  tramite       TramiteDO @relation(fields: [tramiteId], references: [id], onDelete: Restrict)
  montoAplicado BigInt // COP sin decimales
  createdAt     DateTime  @default(now())

  @@index([tramiteId])
  @@index([anticipoId])
  @@map("aplicacion_anticipo")
}

// ─── Facturas de proveedor ────────────────────────────────────────────────────
enum EstadoFacturaProveedor {
  REGISTRADA
  PAGADA
  FACTURADA_CLIENTE
}

model FacturaProveedor {
  id              String                 @id @default(cuid())
  tramiteId       String
  tramite         TramiteDO              @relation(fields: [tramiteId], references: [id], onDelete: Restrict)
  // proveedorNombre/proveedorNit se mantienen como campos legacy para registros existentes.
  // Nuevos registros deben usar beneficiarioId (unificado con Beneficiario).
  proveedorNombre String
  proveedorNit    String?
  beneficiarioId  String?
  beneficiario    Beneficiario?          @relation(fields: [beneficiarioId], references: [id], onDelete: SetNull)
  concepto        String?
  siigoProductoId String?
  siigoProducto   SiigoProducto?         @relation("FacturaProveedorProducto", fields: [siigoProductoId], references: [id], onDelete: SetNull)
  numFactura      String
  valor           BigInt // COP sin decimales
  fecha           DateTime
  /// ¿Se traslada al cliente en la factura de venta? (M6 del PLAN-CONFIGURABILIDAD)
  /// `true` (caso normal): es un gasto pagado por cuenta del cliente y se le
  /// cobra — transporte, impuestos, almacenaje.
  /// `false`: la factura va a nombre de Galcomex y el cliente no debe verla
  /// nunca (caso Ascinter: asesoría). Se registra en el trámite para pagarla y
  /// cruzarla, pero no genera línea en la factura de venta ni cuenta como
  /// desviación en el panel de validaciones.
  repercutible    Boolean                @default(true)
  estado          EstadoFacturaProveedor @default(REGISTRADA)
  documentoId     String?
  documento       Documento?             @relation("FacturaProveedorDoc", fields: [documentoId], references: [id])
  subidaPorId     String
  subidoPor       User                   @relation("FacturasProveedorSubidas", fields: [subidaPorId], references: [id])
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  pagos          PagoTramiteFactura[]
  lineasRevision LineaRevisionFactura[]

  @@unique([tramiteId, numFactura])
  @@index([beneficiarioId])
  @@index([tramiteId, estado])
  @@map("factura_proveedor")
}

// ─── Beneficiarios (proveedores y terceros a quienes se paga) ─────────────────
model Beneficiario {
  id        String   @id @default(cuid())
  nombre    String
  nit       String?
  banco     String?
  numCuenta String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Ficha de empresa a la que corresponde este beneficiario (M5). Permite
  /// cruzar en una sola cuenta corriente lo que se le paga como proveedor y lo
  /// que nos debe como cliente.
  empresaId String?
  empresa   Cliente? @relation("BeneficiarioEmpresa", fields: [empresaId], references: [id], onDelete: SetNull)

  pagos             PagoTramiteBeneficiario[]
  facturasProveedor FacturaProveedor[]
  // Banco asociado a pagos cuando el canal es OTROS_BANCOS / PSE.
  // Se usa como tercero del 4x1000 en la factura de venta.
  pagosBanco        PagoTramite[]             @relation("PagoTramiteBancoBeneficiario")

  @@index([empresaId])
  @@map("beneficiario")
}

// ─── Pagos del trámite ────────────────────────────────────────────────────────
model PagoTramite {
  id                    String           @id @default(cuid())
  tramiteId             String
  tramite               TramiteDO        @relation(fields: [tramiteId], references: [id], onDelete: Restrict)
  concepto              String
  numSoporte            String? // Nro declaración DIAN, factura electrónica, etc.
  documentoId           String?
  documento             Documento?       @relation("SoporteDocumento", fields: [documentoId], references: [id])
  // Comprobante de la página del comercio (puerto/PSE) — opcional; el bancario es el obligatorio.
  comprobanteComercioId String?
  comprobanteComercio   Documento?       @relation("ComprobanteComercio", fields: [comprobanteComercioId], references: [id])
  // Correlaciona los N pagos (uno por DO) creados desde un solo pago multi-trámite
  // (caso Karina/Occidente: un comprobante cubre facturas de varios DOs).
  grupoPagoId           String?
  valor                 BigInt // COP sin decimales
  canalPago             CanalPago
  costoBancario         BigInt           @default(0) // Tomado de MatrizRecaudoPago
  // Banco usado como tercero del 4x1000 en la factura de venta.
  // Bancolombia se auto-resuelve desde SIIGO_BENEFICIARIO_BANCOLOMBIA_ID;
  // otros bancos / PSE → lo elige el operario en el modal "Agregar pago".
  bancoBeneficiarioId   String?
  bancoBeneficiario     Beneficiario?    @relation("PagoTramiteBancoBeneficiario", fields: [bancoBeneficiarioId], references: [id], onDelete: SetNull)
  orden                 Int              @default(0)
  fechaRealPago         DateTime?
  viaSocio              Boolean          @default(false)
  estado                EstadoMovimiento @default(REALIZADO)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  beneficiarios     PagoTramiteBeneficiario[]
  facturasProveedor PagoTramiteFactura[]

  @@index([tramiteId])
  @@index([grupoPagoId])
  @@index([fechaRealPago])
  @@map("pago_tramite")
}

// Pivot N↔N entre PagoTramite y Beneficiario
// Un pago puede ir a varios beneficiarios; un beneficiario puede estar en varios pagos.
model PagoTramiteBeneficiario {
  pagoId         String       @map("pago_id")
  beneficiarioId String       @map("beneficiario_id")
  pago           PagoTramite  @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  beneficiario   Beneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Restrict)

  @@id([pagoId, beneficiarioId])
  @@map("pago_tramite_beneficiario")
}

// Pivot N↔N entre PagoTramite y FacturaProveedor
// Un pago puede cubrir varias facturas; una factura puede tener varios pagos.
model PagoTramiteFactura {
  pagoId    String
  pago      PagoTramite      @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  facturaId String
  factura   FacturaProveedor @relation(fields: [facturaId], references: [id], onDelete: Restrict)

  @@id([pagoId, facturaId])
  @@map("pago_tramite_factura")
}

// ─── Borradores y Facturas ────────────────────────────────────────────────────
enum EstadoBorrador {
  BORRADOR
  EN_REVISION
  APROBADO
  FACTURADO
}

model BorradorFactura {
  id        String    @id @default(cuid())
  tramiteId String
  tramite   TramiteDO @relation(fields: [tramiteId], references: [id], onDelete: Restrict)

  comision                     BigInt // Default 150.000, editable por factura
  ivaComision                  BigInt // 19% sobre comisión
  impuesto4x1000               BigInt // Condicional: solo si saldo a favor del cliente
  costosBancarios              BigInt
  totalAnticipo                BigInt
  totalPagos                   BigInt
  totalFactura                 BigInt
  saldoAFavorCliente           BigInt       @default(0)
  saldoACargoCliente           BigInt       @default(0)
  saldoAFavorLM                BigInt       @default(0)
  saldoACargoLM                BigInt       @default(0)
  retenciones                  BigInt       @default(0)
  conceptosOperacionales       Json?
  // Suma de las líneas (+ comisión + IVA − retenciones). Siempre se calcula.
  // En trámites SOCIO_LM se promueve a totalFactura; en PROPIO es solo referencia.
  totalFacturaLineas           BigInt       @default(0)
  // 4x1000 calculado sobre la base de ingresos de terceros (SOCIO_LM únicamente).
  // Distinto del impuesto4x1000 interno (base anticipo). Para PROPIO queda en 0.
  impuesto4x1000Factura        BigInt       @default(0)
  // Comisión interna Galcomex→Lucho (la mínima, ej. 150.000). Manual, editable
  // en el módulo de Cruce. SOLO afecta el cruce interno; NO toca el saldo a favor
  // del cliente (line-driven). Distinta de `comision` (la de la factura). Para
  // PROPIO queda en 0 (no aplica cruce).
  comisionInternaLM            BigInt       @default(0)
  // Tipo de pago con que Lucho liquida la comisión interna. Exactamente uno de
  // (tipoRecaudoComisionInternaLM, canalPagoComisionInternaLM) debe estar set
  // cuando comisionInternaLM > 0 (validado en código). Para PROPIO ambos null.
  tipoRecaudoComisionInternaLM TipoRecaudo?
  canalPagoComisionInternaLM   CanalPago?
  // Snapshot del costo bancario (matriz_recaudo / matriz_pago) al momento del
  // PATCH, igual que PagoFactura.costoBancario. Se SUMA a `costosBancarios` en
  // el cálculo del saldoLMInterno (ver service.ts:actualizarComisionInternaLM).
  costoComisionInternaLM       BigInt       @default(0)
  // Saldo interno de Galcomex con el socio LM:
  //   saldoLMInterno = anticipo − Σpagos − comisionInternaLM − ivaComision − 4x1000interno − costosBancarios
  // Positivo → Galcomex le debe devolver a LM. Negativo → LM le debe a Galcomex.
  saldoLMInterno               BigInt       @default(0)

  // Comentarios de cabecera (formato Lucho). Array de strings; cada uno es una
  // fila descriptiva (factura comercial, DO+contenedor+BL, mercancía+puerto).
  // Al exportar a SIIGO se unen con saltos de línea en la columna AE Observaciones.
  comentariosCabecera Json?

  // JSON inmutable para auditoría — guardado al aprobar, nunca mutable
  snapshotCalculo Json?

  estado          EstadoBorrador @default(BORRADOR)
  aprobadoPorId   String?
  aprobadoPor     User?          @relation("AprobadoPor", fields: [aprobadoPorId], references: [id])
  fechaAprobacion DateTime?
  facturadoPorId  String?
  facturadoPor    User?          @relation("FacturadoPor", fields: [facturadoPorId], references: [id])
  numFacturaSiigo String? // ej. BAQ-18288
  fechaFactura    DateTime?

  // Forma de pago seleccionada para el envío a Siigo (contado vs crédito).
  // Se elige por borrador porque varía según el trámite.
  formaPagoSiigoId Int?
  formaPago        SiigoFormaPago? @relation(fields: [formaPagoSiigoId], references: [id], onDelete: SetNull)

  /// Tarifario con el que se calcularon los conceptos operacionales (M2).
  /// Null = comisión manual, como antes.
  tarifarioId String?
  tarifario   Tarifario? @relation(fields: [tarifarioId], references: [id], onDelete: SetNull)

  // Envío como borrador a la API de Siigo. La factura se crea como DRAFT en
  // Siigo (stamp.send=false); un usuario superior la valida y la sella desde
  // Siigo. siigoDraftId guarda el id devuelto por Siigo en la creación del
  // borrador para correlación. enviadoASiigoEn marca el último envío exitoso.
  siigoDraftId       String?
  enviadoASiigoEn    DateTime?
  // Trazabilidad de errores/intentos. ultimoErrorSiigo se limpia al éxito.
  // Si está poblado, la UI muestra el mensaje para que el ADMIN reintente.
  ultimoErrorSiigo   String?
  ultimoIntentoSiigo DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factura        Factura?
  lineasRevision LineaRevision[]

  @@index([tramiteId, estado])
  @@index([createdAt])
  @@map("borrador_factura")
}

enum LineaRevisionOrigen {
  AUTO // generada automáticamente desde el libro de pagos
  MANUAL // escrita a mano (portal del socio)
}

// Subsección de la factura de venta. TERCEROS = ingresos recibidos para
// terceros (pass-through). OPERACIONAL = costos/ingresos operacionales propios
// del prestador del servicio (Galcomex).
enum SeccionLinea {
  TERCEROS
  OPERACIONAL
}

model LineaRevision {
  id          String              @id @default(cuid())
  borradorId  String
  borrador    BorradorFactura     @relation(fields: [borradorId], references: [id], onDelete: Cascade)
  concepto    String
  numSoporte  String?
  valor       BigInt
  observacion String?
  aprobada    Boolean             @default(false)
  orden       Int                 @default(0)
  origen      LineaRevisionOrigen @default(AUTO)
  seccion     SeccionLinea        @default(TERCEROS)

  siigoProductoId String?
  siigoProducto   SiigoProducto? @relation(fields: [siigoProductoId], references: [id], onDelete: SetNull)

  // Identifica líneas auto-generadas de conceptos fijos del borrador.
  // "IMPUESTO_4X1000" | "COSTOS_BANCARIOS" | "COMISION" | "IVA_COMISION" | null
  tipoFija String?

  // NIT del tercero ("Id. Tercero" en Siigo) cuando la línea TERCEROS no tiene
  // factura de proveedor vinculada. Si hay factura, el NIT se prefiere desde
  // `factura.beneficiario.nit` (ver `nitTerceroDe` en envio-factura-service).
  // Sin uso para líneas OPERACIONAL o fijas (que resuelven su tercero aparte).
  nitTercero String?

  facturas LineaRevisionFactura[]

  @@map("linea_revision")
}

// Pivot N↔N entre LineaRevision y FacturaProveedor.
// Una línea de la factura de venta puede respaldarse en varias facturas de
// proveedor; una factura de proveedor puede aparecer en varias líneas.
model LineaRevisionFactura {
  lineaId   String
  linea     LineaRevision    @relation(fields: [lineaId], references: [id], onDelete: Cascade)
  facturaId String
  factura   FacturaProveedor @relation(fields: [facturaId], references: [id], onDelete: Restrict)

  @@id([lineaId, facturaId])
  @@map("linea_revision_factura")
}

model Factura {
  id                 String          @id @default(cuid())
  borradorId         String          @unique
  borrador           BorradorFactura @relation(fields: [borradorId], references: [id], onDelete: Restrict)
  clienteId          String
  cliente            Cliente         @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  numSiigo           String          @unique // BAQ-18288
  fecha              DateTime
  totalFactura       BigInt
  saldoAFavorCliente BigInt
  saldoACargoCliente BigInt
  saldoAFavorLM      BigInt
  saldoACargoLM      BigInt
  pdfKey             String? // PDF en MinIO

  // Derivadas: se setean cuando saldoNeto del destino llega a 0
  fechaPagoCliente DateTime?
  fechaPagoLM      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pagos PagoFactura[]

  @@index([clienteId])
  @@index([fecha])
  @@map("factura")
}

// ─── Enums de pagos de factura ────────────────────────────────────────────────
enum DestinoPago {
  CLIENTE
  LM
}

enum TipoPagoFactura {
  ABONO
  DEVOLUCION
}

// ─── Pagos de factura (abonos parciales y devoluciones) ───────────────────────
model PagoFactura {
  id              String           @id @default(cuid())
  facturaId       String
  factura         Factura          @relation(fields: [facturaId], references: [id], onDelete: Restrict)
  destino         DestinoPago
  tipo            TipoPagoFactura
  monto           BigInt // COP enteros, siempre positivo
  fecha           DateTime
  // Exactamente uno de (tipoRecaudo, canalPago) debe estar seteado por pago.
  // Regla de dominio validada en código (no en BD) — ver service.ts y cartera.ts.
  tipoRecaudo     TipoRecaudo? // Recaudo (entra plata) → costo de matriz_recaudo
  canalPago       CanalPago? // Pago (sale plata)  → costo de matriz_pago
  costoBancario   BigInt           @default(0) // Snapshot del cobro al momento del registro
  comprobanteKey  String? // Clave en MinIO del comprobante bancario
  verificadoBanco Boolean          @default(false)
  estado          EstadoMovimiento @default(REALIZADO)
  registradoPorId String
  registradoPor   User             @relation("PagosFacturaRegistrados", fields: [registradoPorId], references: [id])
  createdAt       DateTime         @default(now())

  @@index([facturaId])
  @@index([fecha])
  @@map("pago_factura")
}

// ─── Solicitudes PSE ─────────────────────────────────────────────────────────
model PseSolicitud {
  id            String    @id @default(cuid())
  tramiteId     String
  tramite       TramiteDO @relation(fields: [tramiteId], references: [id], onDelete: Cascade)
  token         String    @unique // Token aleatorio para el link de María Camila
  codigoPseEnc  String? // Código cifrado AES-256-GCM: iv:authTag:ciphertext (hex)
  solicitadoPor String // userId del operador
  expiresAt     DateTime
  respondidaAt  DateTime?
  createdAt     DateTime  @default(now())

  @@map("pse_solicitud")
}

// ─── Parámetros del sistema ───────────────────────────────────────────────────
model Parametro {
  id          String   @id @default(cuid())
  clave       String   @unique
  valor       String // Siempre string; parsear según clave
  descripcion String?
  updatedAt   DateTime @updatedAt

  @@map("parametro")
}

// ─── Catálogo Siigo ───────────────────────────────────────────────────────────
model SiigoProducto {
  id                  String   @id
  codigo              String   @unique
  nombre              String
  tipo                String
  activo              Boolean  @default(true)
  grupoContableId     Int
  grupoContableNombre String
  clasificacionIva    String
  sincronizadoEn      DateTime @default(now()) @updatedAt

  lineasRevision    LineaRevision[]
  impuestos         SiigoProductoImpuesto[]
  facturasProveedor FacturaProveedor[]      @relation("FacturaProveedorProducto")

  @@map("siigo_producto")
}

// ─── Catálogo de impuestos Siigo (espejo de GET /v1/taxes) ────────────────────
model SiigoImpuesto {
  id             Int      @id // ID numérico asignado por Siigo
  nombre         String // "IVA 19%", "ReteFuente 1%", etc.
  tipo           String // "IVA" | "ReteIVA" | "ReteICA" | "Retefuente" | etc.
  porcentaje     String // Decimal como string para preservar precisión ("19.00")
  activo         Boolean  @default(true)
  sincronizadoEn DateTime @default(now()) @updatedAt

  productos SiigoProductoImpuesto[]

  @@map("siigo_impuesto")
}

// Pivot N↔N: cada producto Siigo lleva uno o varios impuestos en Galcomex.
// Asociación manual desde la UI (Siigo no la expone en /v1/products).
model SiigoProductoImpuesto {
  productoId String
  producto   SiigoProducto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  impuestoId Int
  impuesto   SiigoImpuesto @relation(fields: [impuestoId], references: [id], onDelete: Cascade)

  @@id([productoId, impuestoId])
  @@map("siigo_producto_impuesto")
}

// ─── Tipos de comprobante Siigo (espejo de GET /v1/document-types) ───────────
// Tipos de factura de venta disponibles en la cuenta Siigo (Factura
// Electrónica, Factura POS, etc.). Se selecciona uno para todas las facturas
// que envíe Galcomex.
model SiigoTipoComprobante {
  id             Int      @id // ID numérico asignado por Siigo
  code           String // "1", "2"
  nombre         String // "Factura Electrónica de Venta"
  tipo           String? // "FV"
  activo         Boolean  @default(true)
  sincronizadoEn DateTime @default(now()) @updatedAt

  @@map("siigo_tipo_comprobante")
}

// ─── Vendedores Siigo (espejo de GET /v1/users) ──────────────────────────────
// Usuarios de Siigo que figuran como vendedores en las facturas. Se asigna uno
// global para todas las facturas que envíe Galcomex.
model SiigoVendedor {
  id             Int      @id // ID numérico asignado por Siigo
  username       String?
  nombre         String? // first_name + last_name concatenados
  email          String?
  activo         Boolean  @default(true)
  sincronizadoEn DateTime @default(now()) @updatedAt

  @@map("siigo_vendedor")
}

// ─── Formas de pago Siigo (espejo de GET /v1/payment-types) ──────────────────
// Se selecciona una por borrador antes de enviar a Siigo porque contado vs
// crédito varía por trámite.
model SiigoFormaPago {
  id             Int      @id // ID numérico asignado por Siigo
  nombre         String // "Contado", "Crédito 30 días", etc.
  tipo           String? // Clasificación interna de Siigo
  activo         Boolean  @default(true)
  sincronizadoEn DateTime @default(now()) @updatedAt

  borradores BorradorFactura[]

  @@map("siigo_forma_pago")
}

// ─── Auditoría ────────────────────────────────────────────────────────────────
model AuditLog {
  id        String     @id @default(cuid())
  entidad   String // "TramiteDO", "BorradorFactura", etc.
  entidadId String
  accion    String // "CREATE" | "UPDATE" | "APPROVE" | "FACTURAR"
  usuarioId String
  usuario   User       @relation(fields: [usuarioId], references: [id])
  tramiteId String?
  tramite   TramiteDO? @relation(fields: [tramiteId], references: [id])
  antes     Json? // Estado previo (snapshot)
  despues   Json? // Estado posterior (snapshot)
  createdAt DateTime   @default(now())

  @@index([entidad, entidadId])
  @@index([usuarioId])
  @@index([tramiteId])
  @@index([createdAt])
  @@map("audit_log")
}

// ─── M2: Tarifario versionado por empresa ─────────────────────────────────────
// La propuesta comercial de Guillermo (Word con incisos) pasa a ser datos: un
// tarifario por empresa y alcance, con vigencia real (Litoplas: 2-feb → 31-ene)
// y una lista de ítems con su forma de cálculo. El motor puro vive en
// `lib/tarifas/motor.ts`. Ninguna regla de precio se escribe en código.
enum EstadoTarifario {
  BORRADOR
  VIGENTE
  VENCIDO
  REEMPLAZADO
}

/// Cómo se calcula el ítem. Ver `lib/tarifas/motor.ts`.
enum TipoCalculoTarifa {
  FIJO // mismo valor siempre (gastos de trámite por embarque)
  POR_UNIDAD // valor × cantidad (10.000 por declaración, 100.000 por contenedor)
  PORCENTAJE_MIN // % sobre el CIF con mínimo por tipo de carga (CW: 0,37 %)
  PRIMERO_MAS_ADICIONAL // primero a un precio y cada adicional a otro (clasificación)
  ESPEJO_DE_COSTO // se cobra lo mismo que costó (pago del registro VUCE)
}

/// Cuándo entra a la factura.
enum DisparadorTarifa {
  SIEMPRE // en todo trámite
  EVENTO // solo si se marcó el evento del trámite (contenedor abierto, etc.)
  MANUAL // el revisor lo agrega a mano
}

enum UnidadTarifa {
  TRAMITE
  CONTENEDOR
  DECLARACION
  DOCUMENTO
  ITEM
  MES
}

/// Base de cálculo del trámite para tarifas con mínimo por tipo de carga.
enum TipoCarga {
  SUELTA
  CONTENEDOR_20
  CONTENEDOR_40
}

model Tarifario {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Cliente @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  nombre       String // "Tarifas 2026 importaciones"
  /// Línea de servicio que cubre: TRAMITE | CLASIFICACION | PLAN_VALLEJO | EXPORTACION.
  /// Una empresa puede tener un tarifario vigente por cada alcance.
  alcance      String          @default("TRAMITE")
  vigenteDesde DateTime
  vigenteHasta DateTime
  estado       EstadoTarifario @default(BORRADOR)
  version      Int             @default(1)
  notas        String?

  pdfKey    String?
  enviadoAt DateTime?

  creadoPorId String
  creadoPor   User     @relation("TarifarioCreadoPor", fields: [creadoPorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items      TarifaItem[]
  borradores BorradorFactura[]

  @@unique([empresaId, alcance, version])
  @@index([empresaId, estado])
  @@map("tarifario")
}

model TarifaItem {
  id          String    @id @default(cuid())
  tarifarioId String
  tarifario   Tarifario @relation(fields: [tarifarioId], references: [id], onDelete: Cascade)

  orden         Int     @default(0)
  /// Código estable del concepto (GASTOS_TRAMITE, SISTEMATIZACION…). Se conserva
  /// entre versiones y permite comparar tarifarios.
  concepto      String
  /// Nombre tal como sale en la propuesta y en la factura del cliente. Puede
  /// diferir del nombre del producto Siigo.
  nombrePublico String
  /// Código del producto Siigo al que se lleva la línea (sin FK: el catálogo se
  /// sincroniza aparte y puede no estar cargado en todos los entornos).
  siigoCodigo   String?

  tipoCalculo  TipoCalculoTarifa
  disparador   DisparadorTarifa  @default(SIEMPRE)
  /// Evento del catálogo que dispara el ítem cuando `disparador = EVENTO`.
  eventoCodigo String?
  evento       CatalogoEvento?   @relation(fields: [eventoCodigo], references: [codigo], onDelete: SetNull)
  unidad       UnidadTarifa      @default(TRAMITE)

  /// COP sin decimales. FIJO/POR_UNIDAD: valor unitario. PRIMERO_MAS_ADICIONAL: el primero.
  valor          BigInt  @default(0)
  /// PRIMERO_MAS_ADICIONAL: cada unidad adicional.
  valorAdicional BigInt?
  /// PORCENTAJE_MIN: puntos básicos (37 = 0,37 %).
  porcentajeBps  Int?
  /// PORCENTAJE_MIN: mínimos por tipo de carga `{ SUELTA, CONTENEDOR_20, CONTENEDOR_40 }` en COP string.
  minimos        Json?
  /// ESPEJO_DE_COSTO: texto que identifica el pago/factura de proveedor que se espeja.
  conceptoCosto  String?

  aplicaIva Boolean @default(true)
  notas     String?

  @@unique([tarifarioId, concepto])
  @@map("tarifa_item")
}

// ─── M3: Eventos del trámite ──────────────────────────────────────────────────
// Lo "circunstancial" de la reunión: solo se cobra si pasó (se abrió el
// contenedor, hubo entrega directa, se elaboró el registro). Marcar el evento
// deja rastro, exige sus documentos en el checklist y, si el tarifario de la
// empresa tiene un ítem con ese evento, lo lleva a la factura.
model CatalogoEvento {
  codigo               String  @id
  nombre               String
  descripcion          String?
  /// Etiquetas de documentos que el evento exige en el checklist del DO.
  documentosRequeridos Json    @default("[]")
  /// El evento puede repetirse (despacho parcial ×2, modificación de registro ×N).
  permiteCantidad      Boolean @default(false)
  orden                Int     @default(0)
  activo               Boolean @default(true)

  tramites    TramiteEvento[]
  tarifaItems TarifaItem[]

  @@map("catalogo_evento")
}

model TramiteEvento {
  id           String         @id @default(cuid())
  tramiteId    String
  tramite      TramiteDO      @relation(fields: [tramiteId], references: [id], onDelete: Cascade)
  eventoCodigo String
  evento       CatalogoEvento @relation(fields: [eventoCodigo], references: [codigo], onDelete: Restrict)
  cantidad     Int            @default(1)
  observacion  String?
  marcadoPorId String
  marcadoPor   User           @relation("EventoMarcadoPor", fields: [marcadoPorId], references: [id])
  createdAt    DateTime       @default(now())

  @@unique([tramiteId, eventoCodigo])
  @@map("tramite_evento")
}
